# 安全：务必把 key 限制到 HTTP 引荐来源（localhost:5173/* 与 GitHub Pages 域名）
VITE_GOOGLE_MAPS_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
